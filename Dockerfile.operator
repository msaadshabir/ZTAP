# Build stage for operator
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS go-builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o ztap-operator ./cmd/ztap-operator

FROM alpine:3.24@sha256:28bd5fe8b56d1258caf0b82e6b73458c5b694d178ad97c5e925c2d0e1a91

ARG VERSION=dev
ARG REVISION=unknown

LABEL org.opencontainers.image.source="https://github.com/msaadshabir/ZTAP" \
      org.opencontainers.image.title="ZTAP Operator" \
      org.opencontainers.image.description="Kubernetes operator for ZTAP (Zero Trust Access Platform)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

RUN apk add --no-cache ca-certificates

RUN addgroup -g 1000 ztap && \
    adduser -D -u 1000 -G ztap ztap

COPY --from=go-builder /app/ztap-operator /usr/local/bin/ztap-operator

USER ztap

ENTRYPOINT ["/usr/local/bin/ztap-operator"]
