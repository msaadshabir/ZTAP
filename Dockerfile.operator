# Build stage for operator
FROM golang:1.26.3-alpine AS go-builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o ztap-operator ./cmd/ztap-operator

FROM alpine:3.19

RUN apk add --no-cache ca-certificates

RUN addgroup -g 1000 ztap && \
    adduser -D -u 1000 -G ztap ztap

COPY --from=go-builder /app/ztap-operator /usr/local/bin/ztap-operator

USER ztap

ENTRYPOINT ["/usr/local/bin/ztap-operator"]
